const family: { name: string; href?: string; dates: string; link: string }[] = [
  { name: 'George Laurence', href: bayanne('I86837'), dates: '1810 – 2 Sep 1885', link: 'Grocer and baker, Commercial Street. Mouat’s employer.' },
  { name: 'Ann Davidson (Mrs Laurence)', href: bayanne('I85538'), dates: '1832 – 15 Aug 1901', link: `Ran the bakery after 1885. Married ${b('I85276', 'Rev. Alexander Gray Yeats')} in 1893 and died at Skipton.` },
