    sources: [{ label: 'ST 4 May 1929', href: st('19290504', 5, 107) }, { label: 'Bayanne I85538', href: bayanne('I85538') }] },
  { date: 'Mar–Apr 1906', text: 'Jas. Cruickshank’s men from Edinburgh build two new ovens. The paper calls the business “the oldest established bakery business in Shetland”.',
    sources: [{ label: 'ST 7 Apr 1906', href: st('19060407', 4, 103) }] },
  { date: 'Oct 1906', text: 'A fire in the house above the shop damages his stock.',
