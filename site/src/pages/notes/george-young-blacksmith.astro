  .essay li {
    color: var(--text-secondary);
  }

  .essay p {
    margin-bottom: 1.15rem;
  }

  .essay ul {
    margin: 0 0 1.15rem 1.25rem;
  }

  .essay li {
    margin-bottom: 0.6rem;
  }

  .nowrap {
    white-space: nowrap;
  }

  .note {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
