---
import Base from '../../layouts/Base.astro';
import PartyChart, { type PartyGroup } from '../../components/PartyChart.astro';
import { getAllCouncils, getCouncilBySlug, getDistinctElectionPages } from '../../lib/db';

export function getStaticPaths() {
  const councils = getAllCouncils();
  return councils.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const council = getCouncilBySlug(slug!);
if (!council) return Astro.redirect('/');

const elections = getDistinctElectionPages(council.id);

// Group by decade
const byDecade: Record<string, typeof elections> = {};
for (const e of elections) {
  const year = e.election_date?.substring(0, 4) || '????';
  const decade = year.substring(0, 3) + '0s';
  if (!byDecade[decade]) byDecade[decade] = [];
  byDecade[decade].push(e);
}

function formatDate(d: string | null): string {
  if (!d) return '';
  const date = new Date(d);
  return date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', timeZone: 'UTC' });
}

function electionTitle(wpt: string): string {
  return wpt.replace(/_/g, ' ');
}
// Party charts only where party labels were recorded. Bottom-to-top order and colours are
// validated as a set (see PartyChart.astro): Labour at the base so its seats read directly.
const RED = { light: '#e34948', dark: '#e66767' };
const BLUE = { light: '#2a78d6', dark: '#3987e5' };
const YELLOW = { light: '#eda100', dark: '#c98500' };
const AQUA = { light: '#1baf7a', dark: '#199e70' };
const ORANGE = { light: '#eb6834', dark: '#d95926' };
const partyCharts: Record<string, { from: string; groups: PartyGroup[]; note?: string }> = {
  'lerwick-town-council': {
    from: '1900-01-01',
    groups: [
      { label: 'Labour', parties: ['Labour'], ...RED },
      { label: 'Independent', parties: ['Independent'], ...BLUE },
      { label: 'Other', ...YELLOW },
      { label: 'Ratepayers Association', parties: ['Ratepayers Association'], ...AQUA },
    ],
    note: 'Labels were rarely recorded before the 1930s.',
  },
  'shetland-islands-council': {
    from: '1974-05-07',
    groups: [
      { label: 'Labour', parties: ['Labour'], ...RED },
      { label: 'Independent', parties: ['Independent'], ...BLUE },
      { label: 'Other', ...YELLOW },
      { label: 'Shetland Movement', parties: ['Shetland Movement'], ...AQUA },
      { label: 'Scottish Liberal Democrats', parties: ['Scottish Liberal Democrats'], ...ORANGE },
    ],
  },
};
const chart = partyCharts[council.slug];

const councilDesc = `${council.name} - ${elections.length} elections. Browse election results and candidates.`;
---
<Base title={council.name} description={councilDesc}>
  <div class="breadcrumb"><a href="/">Home</a> &rsaquo; {council.name}</div>
  <h1>{council.name}</h1>
  <p class="meta">{elections.length} elections</p>

  {chart && <PartyChart councilSlug={council.slug} from={chart.from} groups={chart.groups} note={chart.note} />}

  {Object.entries(byDecade).map(([decade, items]) => (
    <div>
      <h2>{decade}</h2>
      <ul class="election-list">
        {items.map(e => (
          <li>
            <a href={`/election/${e.min_id}`}>{electionTitle(e.wiki_page_title)}</a>
            <span class={`badge badge-${e.election_type}`}>{e.election_type}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</Base>
