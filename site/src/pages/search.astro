---
import Base from '../layouts/Base.astro';
import { getPersonCount } from '../lib/db';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const personCount = getPersonCount();
---
<Base title="Search">
  <div class="breadcrumb"><a href={`${import.meta.env.BASE_URL}`}>Home</a> &rsaquo; Search</div>
  <h1>Search</h1>

  <input
    type="text"
    id="search-input"
    class="search-input"
    placeholder="Search people, elections, constituencies..."
    autofocus
  />

  <div id="result-count" class="meta" style="display:none;"></div>

  <div id="results"></div>

  <div id="browse-suggestions" class="browse-suggestions">
    <p>Or browse:</p>
    <div class="browse-links">
      <a href="/people" class="browse-link">All {personCount} people</a>
      <a href="/constituencies" class="browse-link">Constituencies</a>
      <a href="/referenda" class="browse-link">Referenda</a>
      <a href="/leadership" class="browse-link">Provosts &amp; Conveners</a>
      <a href="/history" class="browse-link">History of Shetland politics</a>
    </div>
  </div>

  <script define:vars={{ indexUrl: `${base}/search-index.json` }}>
    const input = document.getElementById('search-input');
    const resultsDiv = document.getElementById('results');
    const countDiv = document.getElementById('result-count');
    const suggestionsDiv = document.getElementById('browse-suggestions');

    const typeLabels = {
      person: 'Person',
      election: 'Election',
      constituency: 'Constituency',
    };

    const typeBadgeClass = {
      person: 'badge-person',
      election: 'badge-election',
      constituency: 'badge-constituency',
    };

    function search(query) {
      if (!query || query.length < 2) {
        resultsDiv.innerHTML = '';
        countDiv.style.display = 'none';
        if (suggestionsDiv) suggestionsDiv.style.display = '';
        return;
      }
      if (suggestionsDiv) suggestionsDiv.style.display = 'none';

      const terms = query.toLowerCase().split(/\s+/);
      const scored = [];

      for (const item of searchIndex) {
        const haystack = (item.name + ' ' + item.meta + ' ' + (item.extra || '')).toLowerCase();
        let matched = true;
        let score = 0;

        for (const term of terms) {
          if (!haystack.includes(term)) {
            matched = false;
            break;
          }
          // Boost exact name matches
          if (item.name.toLowerCase().includes(term)) score += 2;
          // Boost start-of-word matches
          if (item.name.toLowerCase().startsWith(term)) score += 3;
        }

        if (matched) {
          scored.push({ ...item, score });
        }
      }

      scored.sort((a, b) => b.score - a.score);
      const top = scored.slice(0, 50);

      countDiv.textContent = `${scored.length} result${scored.length !== 1 ? 's' : ''}`;
      countDiv.style.display = 'block';

      if (top.length === 0) {
        resultsDiv.innerHTML = '<p class="meta">No results found.</p>';
        return;
      }

      resultsDiv.innerHTML = '<ul class="election-list">' + top.map(item => {
        // If match was in extra text (not name/meta), show a snippet
        let snippet = '';
        const nameMeta = (item.name + ' ' + item.meta).toLowerCase();
        const allTermsInNameMeta = terms.every(t => nameMeta.includes(t));
        if (!allTermsInNameMeta && item.extra) {
          const extraLower = item.extra.toLowerCase();
          // Find first matching term's position and extract surrounding text
          for (const term of terms) {
            const idx = extraLower.indexOf(term);
            if (idx !== -1) {
              const start = Math.max(0, idx - 40);
              const end = Math.min(item.extra.length, idx + term.length + 60);
              snippet = (start > 0 ? '...' : '') + item.extra.substring(start, end).trim() + (end < item.extra.length ? '...' : '');
              break;
            }
          }
        }
        return `
          <li>
            <span class="badge ${typeBadgeClass[item.type]}">${typeLabels[item.type]}</span>
            <a href="${item.url}">${item.name}</a>
            ${item.meta ? `<span class="meta" style="margin-left: 0.5rem;">${item.meta}</span>` : ''}
            ${snippet ? `<div class="search-snippet">${snippet}</div>` : ''}
          </li>
        `;
      }).join('') + '</ul>';
    }

    let searchIndex = [];
    const ready = fetch(indexUrl).then(r => r.json()).then(data => { searchIndex = data; });

    input.addEventListener('input', (e) => ready.then(() => search(e.target.value)));

    // Support ?q= query param
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      ready.then(() => search(q));
    }
  </script>

  <style>
    .badge-person { background: var(--success-light); color: var(--success); }
    .badge-election { background: var(--accent-light); color: var(--accent); }
    .badge-constituency { background: var(--warning-bg); color: var(--warning-text); }
    .badge { margin-right: 0.5rem; }
    .search-snippet {
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 0.2rem;
      font-style: italic;
    }
    .browse-suggestions {
      margin-top: 2rem;
    }
    .browse-suggestions p {
      color: var(--text-secondary);
      margin-bottom: 0.75rem;
    }
    .browse-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .browse-link {
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-surface);
      font-size: 0.9rem;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .browse-link:hover {
      border-color: var(--accent);
      box-shadow: var(--shadow-sm);
      text-decoration: none;
    }
  </style>
</Base>
