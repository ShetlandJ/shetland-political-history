---
import Base from '../layouts/Base.astro';
import Database from 'better-sqlite3';
import path from 'path';

const db = new Database(path.join(process.cwd(), '..', 'shetland.db'), { readonly: true });

const councils = db.prepare(`
  SELECT co.id, co.name, co.slug, MIN(ct.start_date) as first, MAX(COALESCE(ct.end_date, '')) as last
  FROM councils co JOIN council_terms ct ON ct.council_id = co.id
  GROUP BY co.id ORDER BY co.id
`).all() as any[];

// Compact rows for the client: one per term of service.
const terms = db.prepare(`
  SELECT co.slug as council, ct.person_name as n, p.slug as s, k.name as w, c.party as p,
         ct.start_date as a, ct.end_date as b, ct.start_reason as j, ct.end_reason as l,
         ct.confirmed as c, e.id as e
  FROM council_terms ct
  JOIN councils co ON co.id = ct.council_id
  LEFT JOIN people p ON p.id = ct.person_id
  LEFT JOIN constituencies k ON k.id = ct.constituency_id
  LEFT JOIN candidacies c ON c.id = ct.candidacy_id
  LEFT JOIN elections e ON e.id = c.election_id
  ORDER BY ct.start_date, ct.person_name
`).all() as any[];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = JSON.stringify({ base, councils, terms });
---
<Base title="Who Served When">
  <div class="breadcrumb">
    <a href="/">Home</a> &rsaquo; Who Served When
  </div>

  <h1>Who Served When</h1>
  <p class="meta">
    Pick a council and a date to see who was sitting on it that day, with the party each
    member stood under when they won the seat. Lerwick Town Council membership is built from
    newspaper and minute-book research; Zetland County Council and Shetland Islands Council
    membership is traced from ward results, deaths and by-elections. Some periods are still
    being researched: see the <a href={`${base}/data-review#composition`}>membership checks</a>.
  </p>

  <form class="picker" id="picker">
    <label>
      <span>Council</span>
      <select id="council">
        {councils.map((c: any) => <option value={c.slug}>{c.name}</option>)}
      </select>
    </label>
    <label>
      <span>Date</span>
      <input type="date" id="date" required />
    </label>
  </form>

  <section id="result" aria-live="polite">
    <h2 id="result-title"></h2>
    <p class="meta" id="result-meta"></p>
    <div class="tally" id="tally"></div>
    <div class="table-wrap">
      <table id="members">
        <thead>
          <tr>
            <th>Name</th>
            <th class="ward-col">Ward</th>
            <th>Party</th>
            <th>From</th>
            <th>Until</th>
            <th>How joined</th>
            <th>How left</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section id="party-section" hidden>
    <h2 id="party-title"></h2>
    <p class="meta">Each row is a period during which the same members of this party were sitting.</p>
    <div class="table-wrap">
      <table id="party-periods">
        <thead><tr><th>From</th><th>Until</th><th>Members</th><th>Who</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <script type="application/json" id="terms-data" set:html={data} />
</Base>

<script>
  interface Term {
    council: string; n: string; s: string | null; w: string | null; p: string | null;
    a: string; b: string | null; j: string; l: string | null; c: number; e: number | null;
  }
  interface Council { slug: string; name: string; first: string; last: string; }

  const { base, councils, terms } = JSON.parse(document.getElementById('terms-data')!.textContent!) as
    { base: string; councils: Council[]; terms: Term[] };

  const councilSel = document.getElementById('council') as HTMLSelectElement;
  const dateInput = document.getElementById('date') as HTMLInputElement;
  const NO_PARTY = 'No party recorded';
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function fmt(d: string | null): string {
    if (!d) return 'present';
    const [y, m, day] = d.split('-');
    return day ? `${parseInt(day)} ${MONTHS[parseInt(m) - 1]} ${y}` : d;
  }

  function reason(r: string | null): string {
    return r ? r.replace(/_/g, ' ') : '';
  }

  // One row per person: where two terms overlap (flagged on the data review page), keep the later.
  function sitting(list: Term[], date: string): Term[] {
    const byPerson = new Map<string, Term>();
    for (const t of list) {
      if (t.a <= date && (t.b === null || t.b > date)) byPerson.set(t.s || t.n, t);
    }
    return [...byPerson.values()];
  }

  function el(tag: string, text?: string, cls?: string): HTMLElement {
    const e = document.createElement(tag);
    if (text !== undefined) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }

  function personCell(t: Term): HTMLElement {
    const td = el('td');
    if (t.s) {
      const a = el('a', t.n) as HTMLAnchorElement;
      a.href = `${base}/person/${t.s}`;
      td.appendChild(a);
    } else {
      td.textContent = t.n;
    }
    if (t.c) td.appendChild(el('span', 'confirmed', 'confirmed'));
    return td;
  }

  function render() {
    const slug = councilSel.value;
    const council = councils.find(c => c.slug === slug)!;
    const date = dateInput.value;
    const list = terms.filter(t => t.council === slug);
    const wardBased = list.some(t => t.w);
    document.querySelectorAll('.ward-col').forEach(e => (e as HTMLElement).hidden = !wardBased);

    const title = document.getElementById('result-title')!;
    const meta = document.getElementById('result-meta')!;
    const tbody = document.querySelector('#members tbody')!;
    const tally = document.getElementById('tally')!;
    tbody.replaceChildren();
    tally.replaceChildren();
    document.getElementById('party-section')!.hidden = true;

    if (!date) return;
    const members = sitting(list, date).sort((x, y) =>
      wardBased ? (x.w || '').localeCompare(y.w || '') || x.n.localeCompare(y.n) : x.n.localeCompare(y.n));

    title.textContent = `${council.name} on ${fmt(date)}`;
    if (!members.length) {
      meta.textContent = `No members recorded on this date. Records run from ${fmt(council.first)}` +
        (council.last ? ` to ${fmt(council.last)}.` : '.');
      return;
    }
    const unconfirmed = slug === 'lerwick-town-council' && members.some(m => !m.c);
    meta.textContent = `${members.length} members sitting.` +
      (unconfirmed ? ' Not every term on this date has been confirmed from primary sources yet.' : '');

    const counts = new Map<string, number>();
    for (const m of members) counts.set(m.p || NO_PARTY, (counts.get(m.p || NO_PARTY) || 0) + 1);
    for (const [party, n] of [...counts].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0]))) {
      const b = el('button', `${party} ${n}`, 'tally-item') as HTMLButtonElement;
      b.type = 'button';
      b.title = `Show ${party} members over time`;
      b.addEventListener('click', () => renderParty(list, council, party));
      tally.appendChild(b);
    }

    for (const m of members) {
      const tr = el('tr');
      tr.appendChild(personCell(m));
      if (wardBased) tr.appendChild(el('td', m.w || ''));
      tr.appendChild(el('td', m.p || ''));
      const from = el('td');
      if (m.e) {
        const a = el('a', fmt(m.a)) as HTMLAnchorElement;
        a.href = `${base}/election/${m.e}`;
        from.appendChild(a);
      } else {
        from.textContent = fmt(m.a);
      }
      tr.appendChild(from);
      tr.appendChild(el('td', fmt(m.b)));
      tr.appendChild(el('td', reason(m.j)));
      tr.appendChild(el('td', reason(m.l)));
      tbody.appendChild(tr);
    }
  }

  function renderParty(list: Term[], council: Council, party: string) {
    const mine = list.filter(t => (t.p || NO_PARTY) === party);
    const points = [...new Set(mine.flatMap(t => [t.a, ...(t.b ? [t.b] : [])]))].sort();
    const rows: { from: string; to: string | null; who: Term[] }[] = [];
    for (let i = 0; i < points.length; i++) {
      const who = sitting(mine, points[i]);
      const key = who.map(t => t.n).sort().join('|');
      const last = rows[rows.length - 1];
      if (last && last.to === points[i] && last.who.map(t => t.n).sort().join('|') === key) {
        last.to = points[i + 1] ?? null;
      } else {
        rows.push({ from: points[i], to: points[i + 1] ?? null, who });
      }
    }
    const tbody = document.querySelector('#party-periods tbody')!;
    tbody.replaceChildren();
    for (const r of rows.filter(r => r.who.length)) {
      const tr = el('tr');
      tr.appendChild(el('td', fmt(r.from)));
      tr.appendChild(el('td', r.to ? fmt(r.to) : 'present'));
      tr.appendChild(el('td', String(r.who.length)));
      tr.appendChild(el('td', r.who.map(t => t.n).sort().join(', ')));
      tbody.appendChild(tr);
    }
    document.getElementById('party-title')!.textContent = `${party} on ${council.name}`;
    const section = document.getElementById('party-section')!;
    section.hidden = false;
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function syncUrl() {
    const q = new URLSearchParams({ council: councilSel.value, date: dateInput.value });
    history.replaceState(null, '', `${location.pathname}?${q}`);
  }

  const params = new URLSearchParams(location.search);
  if (params.get('council') && councils.some(c => c.slug === params.get('council'))) {
    councilSel.value = params.get('council')!;
  }
  dateInput.value = params.get('date') || '1955-06-01';

  councilSel.addEventListener('change', () => { render(); syncUrl(); });
  dateInput.addEventListener('change', () => { render(); syncUrl(); });
  render();
</script>

<style>
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .picker label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .picker select,
  .picker input {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 400;
    font-size: 0.95rem;
  }

  #result-title,
  #party-title {
    margin-bottom: 0.25rem;
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }

  :global(.tally-item) {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-surface);
    color: var(--text);
    cursor: pointer;
  }

  :global(.tally-item:hover),
  :global(.tally-item:focus-visible) {
    border-color: var(--accent);
  }

  .table-wrap {
    overflow-x: auto;
  }

  :global(.confirmed) {
    margin-left: 0.4rem;
    font-size: 0.7rem;
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    background: var(--success-light);
    white-space: nowrap;
  }
</style>
